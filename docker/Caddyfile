# docker/Caddyfile
# High-performance reverse proxy for Tarantool VoIP Ecosystem Dashboard

:80, :8080, :8088 {
    encode gzip zstd
    
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Server "Caddy-Tarantool-VoIP"
    }

    reverse_proxy 172.28.0.89:8089 {
        header_up Host {host}
    }
}
